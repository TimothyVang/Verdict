// VERDICT dev container — opens any host with Docker into a reproducible
// toolchain (uv/Python 3.11, Node 20, pnpm, Rust 1.88) plus the 6 MCPs
// from .mcp.json and the 18 skills under .claude/skills/. See README.md
// in this folder for what is NOT in here (Microsandbox, SGLang) and why.
{
    "name": "VERDICT dev",

    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "remoteUser": "vscode",

    // host.docker.internal is needed so the container can reach the host's
    // Langfuse :3000, SGLang :30000/:30001, and Microsandbox API. The
    // host-gateway flag works on Linux + Docker Desktop without --net=host.
    "runArgs": [
        "--add-host=host.docker.internal:host-gateway"
    ],

    // Pass through host shell creds without baking them into the image
    // (CLAUDE.md §3.9). If a var is unset on the host, the container sees
    // it unset — never a literal default.
    "remoteEnv": {
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
        "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
        "LANGFUSE_HOST": "http://host.docker.internal:3000",
        "LANGFUSE_PUBLIC_KEY": "${localEnv:LANGFUSE_PUBLIC_KEY}",
        "LANGFUSE_SECRET_KEY": "${localEnv:LANGFUSE_SECRET_KEY}",
        "SGLANG_BASE_URL": "http://host.docker.internal:30000",
        "SGLANG_GLM_BASE_URL": "http://host.docker.internal:30001"
    },

    // Forwarded so VS Code's port view shows them and so cross-host port
    // proxying (Codespaces / Remote-SSH) behaves predictably.
    "forwardPorts": [3000, 30000, 30001],

    // Runs once per container creation. Idempotent — safe across rebuilds.
    "postCreateCommand": "bash .devcontainer/post-create.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "redhat.vscode-yaml",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspaces/Verdict/.venv/bin/python",
                "python.terminal.activateEnvironment": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true
                },
                "rust-analyzer.cargo.features": "all",
                "files.eol": "\n"
            }
        }
    },

    // Keeps `git submodule update --init` working inside the container by
    // forwarding the host's git/SSH config and the global gitignore.
    "mounts": [
        "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached,readonly"
    ]
}
