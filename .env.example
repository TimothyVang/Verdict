# --- VERDICT environment template ---
#
# Copy to .env (gitignored) and fill in. Loaded by `verdict doctor` and the
# runtime gateway. Every var is checked at startup; missing required vars
# fail loudly. There is no MOCK or TEST_MODE bypass (CLAUDE.md §3.10).

# ─── Mode override (optional) ─────────────────────────────────────────────
# Auto-detected by `verdict/runtime/mode_detect.py` based on what's reachable.
# Set to force a specific mode. Locked at case_init regardless.
# Values: cloud | airgap | dual
# VERDICT_MODE=cloud

# ─── Cloud lane: Anthropic / Claude Code ──────────────────────────────────
# Required for CLOUD and DUAL modes. Ignored in AIRGAP.
# Three credential paths in order of precedence:
#   1. ANTHROPIC_API_KEY (this file or shell export)
#   2. Claude Code OAuth (~/.claude/credentials.json) — interactive login
#   3. ANTHROPIC_API (legacy alias, lower priority)
# OAuth tokens are NOT redistributable (Anthropic commercial terms);
# never commit them, never bake into images.
ANTHROPIC_API_KEY=

# ─── Air-gap lane: SGLang local inference ─────────────────────────────────
# Required for AIRGAP and DUAL modes. Two endpoints:
#   - Qwen3-30B-A3B-Thinking-2507 (planner + executor) on :30000
#   - GLM-4.5-Air (verifier only)              on :30001
SGLANG_BASE_URL=http://localhost:30000
SGLANG_GLM_BASE_URL=http://localhost:30001

# Models — must match what your sglang_server_v1 was launched with.
SGLANG_QWEN_MODEL=Qwen/Qwen3-30B-A3B-Thinking-2507
SGLANG_GLM_MODEL=zai-org/GLM-4.5-Air

# ─── Langfuse self-host (observability) ───────────────────────────────────
# Required in all modes. v2 (Postgres-only, ~1.5GB RAM) by default;
# v3 (ClickHouse, ≥16GB RAM) via docker-compose.langfuse-v3.yml.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Microsandbox (libkrun microVM tool isolation) ────────────────────────
# Per-tool ephemeral VMs with read-only /evidence mount + noexec.
# rootfs_sha256 is pinned; mismatch = sandbox_failure ledger event.
MICROSANDBOX_ROOTFS_PATH=/var/lib/microsandbox/sift-2026.03.24.qcow2
MICROSANDBOX_ROOTFS_SHA256=
MICROSANDBOX_NETWORK_DEFAULT=false

# ─── Ledger / chain-of-custody ────────────────────────────────────────────
# HMAC key for ledger entry signing. TPM-backed if /dev/tpmrm0 present;
# otherwise gpg-encrypted at the path below (passphrase prompted at boot).
VERDICT_HMAC_KEY_PATH=~/.verdict/key.gpg
VERDICT_TPM_DEVICE=/dev/tpmrm0

# Where ledgers + checkpoint DBs live. One subdir per case_id.
VERDICT_CASES_DIR=~/cases

# Where evidence is mounted into microVMs (read-only, noexec).
# Host-side this is chattr +i; never write here.
VERDICT_EVIDENCE_MOUNT=/evidence

# ─── Inspect AI eval harness ──────────────────────────────────────────────
# Used by `inspect eval inspect_ai/tasks/verdict_eval_*.py`.
# Ground-truth fixtures live under inspect_ai/ground_truth/.
INSPECT_AI_LOG_DIR=./inspect_logs

# ─── Adapters (optional integrations) ─────────────────────────────────────
# Leave blank to disable. Credentials injected via TSI on host egress only;
# they NEVER enter a microVM (CLAUDE.md §3.9).
OPENCTI_URL=
OPENCTI_TOKEN=
VELOCIRAPTOR_API_URL=
VELOCIRAPTOR_API_KEY=
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_CHAT_ID=

# ─── Claude Code MCP servers (.mcp.json allowlist) ────────────────────────
# Referenced by .mcp.json via ${VAR} substitution. Tokens stay in the host
# shell env / this gitignored .env file; they NEVER enter a microVM (§3.9)
# and NEVER appear as literals in .mcp.json. See docs/MCP_FRAMEWORK.md.
GITHUB_TOKEN=

# ─── Auto-set at runtime (do NOT hand-set) ────────────────────────────────
# LANGFUSE_TRACE_ID    — per graph.invoke
# LANGFUSE_SESSION_ID  — = case_id, full case lifetime
